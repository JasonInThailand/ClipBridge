<Window x:Class="ClipBridge.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge settings" Width="520" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterOwner" Background="#202226" Foreground="#EEEEEE" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2A2D33"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="CaretBrush" Value="#EEEEEE"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C8CCD2"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="18">
    <TextBlock Text="Sync" FontWeight="Bold" FontSize="15" Foreground="#EEEEEE" Margin="0,0,0,6"/>
    <TextBlock Text="Shared key (must be identical on both machines):"/>
    <TextBox x:Name="KeyBox"/>
    <TextBlock Text="Peer address (optional, only needed if auto-discovery fails, e.g. 192.168.0.236):"/>
    <TextBox x:Name="PeerBox"/>
    <TextBlock Text="This machine's name as shown to peers:"/>
    <TextBox x:Name="NameBox"/>
    <CheckBox x:Name="SyncChk" Content="Enable sync with other machines"/>

    <TextBlock Text="History" FontWeight="Bold" FontSize="15" Foreground="#EEEEEE" Margin="0,10,0,6"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Max items"/><TextBox x:Name="MaxItemsBox"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Max image (MB)"/><TextBox x:Name="MaxImageBox"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Max file transfer (MB)"/><TextBox x:Name="MaxFileBox"/></StackPanel>
    </Grid>
    <CheckBox x:Name="OcrChk" Content="Read text inside copied images (OCR) so they are searchable"/>
    <CheckBox x:Name="StartChk" Content="Start ClipBridge when Windows starts"/>
    <CheckBox x:Name="RememberPosChk" Content="Reopen the list window where I last dragged it (otherwise it opens near the mouse)"/>

    <TextBlock Text="Hotkeys" FontWeight="Bold" FontSize="15" Foreground="#EEEEEE" Margin="0,10,0,6"/>
    <TextBlock TextWrapping="Wrap" Text="Ctrl+Alt+1..9 paste slot  ·  Ctrl+Alt+Shift+1..9 paste as plain text  ·  Ctrl+Alt+V open list  ·  Ctrl+Alt+T type-it-out mode  ·  Ctrl+Alt+Q paste queue on/off  ·  Ctrl+Alt+P paste next queued  ·  hold Ctrl+Alt for the HUD"/>

    <TextBlock x:Name="Note" Foreground="#F5B82E" Margin="0,12,0,0" TextWrapping="Wrap" Text=""/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancel"/>
      <Button Content="Save" Width="90" Padding="0,5" Click="OnSave" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
